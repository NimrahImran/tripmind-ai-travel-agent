# Copy this file to ".env" only if you run TripMind on your own computer.
# On Vercel, add the same name under Project → Settings → Environment Variables.
# Never share your real key or commit it to GitHub.

GEMINI_API_KEY=paste_your_key_here

# Optional: models to try, in order (comma separated)
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
