{
  "name": "tripmind",
  "version": "1.0.0",
  "private": true,
  "description": "TripMind — an AI travel advisor agent that plans trips with live weather, currency and maps, streamed step by step.",
  "author": "Nimra Imran",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
